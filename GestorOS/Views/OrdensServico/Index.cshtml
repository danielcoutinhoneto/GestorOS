@using GestorOS.Helpers
@using GestorOS.Models.Enuns
@using GestorOS.Models.ViewModels
@model OrdemServicoFiltroViewModel
@{
    ViewData["Title"] = "Ordens de Serviço";

    // monta a querystring de ordenação/filtro atual, pra reaproveitar nos links de paginação e ordenação
    string RotaPagina(int pagina) => Url.Action("Index", new
    {
        status = Model.Status,
        cliente = Model.Cliente,
        dataInicio = Model.DataInicio?.ToString("yyyy-MM-dd"),
        dataFim = Model.DataFim?.ToString("yyyy-MM-dd"),
        ordenarPor = Model.OrdenarPor,
        pagina
    })!;

    string RotaOrdenacao(string campo) => Url.Action("Index", new
    {
        status = Model.Status,
        cliente = Model.Cliente,
        dataInicio = Model.DataInicio?.ToString("yyyy-MM-dd"),
        dataFim = Model.DataFim?.ToString("yyyy-MM-dd"),
        ordenarPor = campo,
        pagina = 1
    })!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-clipboard-list me-2"></i>Ordens de Serviço</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Nova Ordem</a>
</div>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small mb-1">Cliente</label>
            <input type="text" name="cliente" value="@Model.Cliente" class="form-control" placeholder="Buscar por cliente..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Status</label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusOrdem>()">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">De</label>
            <input type="date" name="dataInicio" value="@Model.DataInicio?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Até</label>
            <input type="date" name="dataFim" value="@Model.DataFim?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill"><i class="fa-solid fa-filter me-1"></i>Filtrar</button>
        </div>
        <div class="col-md-1">
            <a asp-action="Index" class="btn btn-outline-secondary w-100" title="Limpar filtros"><i class="fa-solid fa-xmark"></i></a>
        </div>
    </form>
</div>

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <span class="text-muted small">
            @Model.TotalRegistros ordem(ns) encontrada(s) &middot; valor total
            <strong class="text-dark">@Model.ValorTotal.ToString("C")</strong>
        </span>
    </div>

    @if (!Model.Ordens.Any())
    {
        <p class="text-muted mb-0">Nenhuma ordem de serviço encontrada com esses filtros.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th><a class="text-decoration-none text-dark" href="@RotaOrdenacao("cliente")">Cliente</a></th>
                        <th>Descrição</th>
                        <th><a class="text-decoration-none text-dark" href="@RotaOrdenacao(Model.OrdenarPor == "data_desc" ? "data_asc" : "data_desc")">Data <i class="fa-solid fa-sort fa-2xs"></i></a></th>
                        <th>Status</th>
                        <th class="text-end"><a class="text-decoration-none text-dark" href="@RotaOrdenacao(Model.OrdenarPor == "valor_desc" ? "valor_asc" : "valor_desc")">Valor <i class="fa-solid fa-sort fa-2xs"></i></a></th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Ordens)
                    {
                        <tr>
                            <td>@o.Cliente?.Nome</td>
                            <td>@o.Descricao</td>
                            <td>@o.DataAbertura.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @o.Status.ParaClasseBadge()">
                                    <i class="fa-solid @o.Status.ParaIcone() me-1"></i>@o.Status.ParaTexto()
                                </span>
                            </td>
                            <td class="text-end">@o.Valor.ToString("C")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@o.Id" class="btn btn-sm btn-outline-danger" title="Excluir"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.PaginaAtual == 1 ? "disabled" : "")">
                        <a class="page-link" href="@RotaPagina(Model.PaginaAtual - 1)">Anterior</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <li class="page-item @(p == Model.PaginaAtual ? "active" : "")">
                            <a class="page-link" href="@RotaPagina(p)">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaAtual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@RotaPagina(Model.PaginaAtual + 1)">Próxima</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>