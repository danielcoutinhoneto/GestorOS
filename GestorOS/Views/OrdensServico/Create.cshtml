@using GestorOS.Models.Enuns
@model OrdemServico
@{
    ViewData["Title"] = "Nova Ordem de Serviço";
}

<div class="card p-4 mx-auto" style="max-width: 720px;">
    <h4 class="mb-4"><i class="fa-solid fa-clipboard-list me-2"></i>Nova Ordem de Serviço</h4>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ClienteId" class="form-label"></label>
                <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select">
                    <option value="">Selecione um cliente...</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoriaServicoId" class="form-label"></label>
                <select asp-for="CategoriaServicoId" asp-items="ViewBag.Categorias" class="form-select">
                    <option value="">Sem categoria</option>
                </select>
            </div>

            <div class="col-12">
                <label asp-for="Descricao" class="form-label"></label>
                <input asp-for="Descricao" class="form-control" placeholder="Ex: Troca de peça, manutenção preventiva..." />
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Observacoes" class="form-label"></label>
                <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Detalhes adicionais (opcional)"></textarea>
            </div>

            <div class="col-md-4">
                <label asp-for="DataAbertura" class="form-label"></label>
                <input asp-for="DataAbertura" class="form-control" type="date" value="@Model?.DataAbertura.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DataAbertura" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusOrdem>()" class="form-select"></select>
            </div>

            <div class="col-md-4">
                <label asp-for="Valor" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">R$</span>
                    <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0" placeholder="0,00" />
                </div>
                <span asp-validation-for="Valor" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Salvar Ordem</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}