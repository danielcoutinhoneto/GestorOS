@using GestorOS.Helpers
@model OrdemServico
@{
    ViewData["Title"] = $"Impressão - Ordem #{Model.Id}";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Ordem de Serviço #@Model.Id</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            padding: 40px;
        }

        .cabecalho {
            border-bottom: 3px solid #4f46e5;
            padding-bottom: 12px;
            margin-bottom: 24px;
        }

        dt {
            color: #6c757d;
            font-weight: 600;
        }
    </style>
</head>
<body onload="window.print()">
    <div class="cabecalho d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Ordem de Serviço #@Model.Id</h3>
        <span class="badge bg-dark fs-6">@Model.Status.ParaTexto()</span>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@Model.Cliente?.Nome</dd>

        <dt class="col-sm-3">Categoria</dt>
        <dd class="col-sm-9">@(Model.CategoriaServico?.Nome ?? "Não informada")</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">@Model.Descricao</dd>

        <dt class="col-sm-3">Observações</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "-" : Model.Observacoes)</dd>

        <dt class="col-sm-3">Data de abertura</dt>
        <dd class="col-sm-9">@Model.DataAbertura.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Data de conclusão</dt>
        <dd class="col-sm-9">@(Model.DataConclusao?.ToString("dd/MM/yyyy") ?? "-")</dd>

        <dt class="col-sm-3">Valor total</dt>
        <dd class="col-sm-9 fs-5 fw-bold">@Model.Valor.ToString("C")</dd>
    </dl>

    <p class="text-muted small mt-5 border-top pt-3">Documento gerado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
</body>
</html>